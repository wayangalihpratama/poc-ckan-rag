# ==============================================================================
# CKAN Environment Configuration
# ==============================================================================

# CKAN Web Portal Configuration
CKAN_SITE_URL=http://localhost:5000
CKAN_PORT=5000

# PostgreSQL Configuration
POSTGRES_USER=ckan_default
POSTGRES_PASSWORD=ckan_password
POSTGRES_DB=ckan_default
POSTGRES_PORT=5432

DATASTORE_DB=datastore_default
DATASTORE_READ_USER=datastore_default
DATASTORE_READ_PASSWORD=datastore_password

# Apache Solr Configuration
SOLR_PORT=8983

# Redis Configuration
REDIS_PORT=6379

# ==============================================================================
# Akvo RAG Integration Configuration
# ==============================================================================

# Base URL for Akvo RAG platform (Local Ngrok HTTPS or host URL)
AKVO_RAG_BASE_URL=https://akvo.ngrok.dev

# Akvo RAG Superuser Token (Used by CLI `ckan akvorag register`)
AKVO_RAG_SUPERUSER_TOKEN=

# Generated Host App Credentials (Populated automatically after registration)
AKVO_RAG_APP_ID=
AKVO_RAG_APP_TOKEN=
AKVO_RAG_KNOWLEDGE_BASE_ID=
